{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Silicon: Start Server",
      "type": "shell",
      "command": "python Silicon.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Automatically start the Silicon IDE server listening on port 6969"
    },
    {
      "label": "Silicon: Stop Server",
      "type": "shell",
      "command": "python Silicon.py --Stop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Stop the running Silicon IDE server on port 6969"
    },
    {
      "label": "Silicon: Clear Project",
      "type": "shell",
      "command": "python Silicon.py --Clear",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Clear all synchronized project files in Silicon/Game by moving them to the Recycle Bin"
    }
  ]
}
